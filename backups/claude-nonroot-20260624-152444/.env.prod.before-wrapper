STEAMDECK_REMOTE_WORKDIR=/home/deck
STEAMDECK_CODEX_BIN=codex
STEAMDECK_SSH_KEY_PATH=/root/CodexWeb/data/secrets/steamdeck_ssh_key
STEAMDECK_COMMAND_TIMEOUT_MS=120000
STEAMDECK_ALLOW_DANGEROUS_COMMANDS=false
