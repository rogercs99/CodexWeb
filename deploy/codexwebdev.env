HOST=127.0.0.1
PORT=3060
NODE_ENV=production

# Required secrets
SESSION_SECRET=820f411bbd8195289a9d07a60b4374a54cd2cb7ac33405144af8c960a7b0aa61
CREDENTIALS_ENCRYPTION_KEY=fe+HsEZxIIRBaZps6/jsoW5aOuMhnJwnNoqyI93SmM4ui+4DLpwevJ1hmfurdHik

# Keep codexwebdev isolated from codexweb production data/state
DB_PATH=.runtime/dev/app.dev.db
UPLOADS_DIR=.runtime/dev/uploads
TASK_SNAPSHOTS_DIR=.runtime/dev/tmp/task-snapshots
TASK_SNAPSHOT_MAX_FILES=900
TASK_SNAPSHOT_MAX_FILE_BYTES=8388608
TASK_SNAPSHOT_MAX_TOTAL_BYTES=67108864
TASK_SNAPSHOTS_RETENTION_MAX_BYTES=536870912
TASK_SNAPSHOTS_RETENTION_MAX_ENTRIES=10
TASK_SNAPSHOTS_RETENTION_MAX_AGE_HOURS=12
TASK_SNAPSHOTS_PRUNE_INTERVAL_MINUTES=20
STORAGE_JOBS_DIR=.runtime/dev/tmp/storage-jobs
RESTART_STATE_PATH=.runtime/dev/restart-state.dev.json
STATIC_ASSETS_DIR=.runtime/dev/public
CODEX_HOME_ROOT=/root/CodexWeb/.runtime/dev/codex_users
CODEX_AUTH_TEMPLATE_DIR=/root/.codex
RCLONE_BIN=rclone
RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
RCLONE_DRIVE_DEFAULT_REMOTE=codexwebdev-gdrive
RCLONE_DRIVE_DEFAULT_ROOT=CodexWebDEV
STORAGE_RESIDUAL_SCAN_ROOTS=/root/CodexWeb/.runtime/dev/tmp,/root/CodexWeb/.runtime/dev/uploads,/root/stremio-app-data/stremio-cache,/srv/stremio-server/home/.stremio-server/stremio-cache,/srv/stremio-service/downloads/.tmp,/tmp,/var/tmp

# AI/tool runtime settings
CODEX_CMD=codex
GEMINI_CMD=gemini
GEMINI_INCLUDE_DIRECTORIES=/
GIT_TOOLS_SCAN_ROOTS=/root/CodexWeb,/opt

# Claude Code CLI integration
CLAUDE_CODE_ENABLED=true
CLAUDE_CODE_BIN=/usr/local/bin/claude-codexweb-max
CLAUDE_CODE_RUN_AS_USER=claude-codexweb
CLAUDE_CODE_WRAPPER_BIN=/usr/local/bin/claude-codexweb-max
CLAUDE_CODE_DEFAULT_MODEL=claude-haiku-4-5
CLAUDE_CODE_DEFAULT_REASONING_EFFORT=low
CLAUDE_CODE_DEFAULT_CWD=/root/CodexWeb
CLAUDE_CODE_TIMEOUT_MS=900000
CLAUDE_CODE_ALLOWED_CWDS=/root/CodexWeb
CHAT_INACTIVITY_TIMEOUT_MS=1200000
CHAT_HARD_TIMEOUT_MS=21600000
CHAT_INACTIVITY_NOTICE_INTERVAL_MS=300000
CHAT_AUTO_CONTINUATIONS=2
CHAT_CONTINUATION_TAIL_CHARS=7000

# Steam Deck SSH (DEV)
STEAMDECK_SSH_ENABLED=true
STEAMDECK_SSH_HOST=
STEAMDECK_SSH_PORT=22
STEAMDECK_SSH_USER=deck
STEAMDECK_REMOTE_WORKDIR=/home/deck
STEAMDECK_CODEX_BIN=codex
STEAMDECK_SSH_KEY_PATH=/root/CodexWeb/data/secrets/steamdeck_ssh_key
STEAMDECK_COMMAND_TIMEOUT_MS=120000
STEAMDECK_ALLOW_DANGEROUS_COMMANDS=false
